# Server
PORT=3000
NODE_ENV=production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=25

# JWT / Auth
JWT_SECRET=
TOKEN_EXPIRES_IN=1292400
AUTH_USERNAME=
AUTH_PASSWORD=

# Redis (cache + distributed rate limit)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://:password@host:6379
# REDIS_PASSWORD=

# Cache TTL (seconds)
CACHE_TTL_SECONDS=300
CACHE_USER_TTL_SECONDS=300
CACHE_DISPLAY_TTL_SECONDS=600
CACHE_MISS_TTL_SECONDS=60

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_HEAVY_WINDOW_MS=60000
RATE_LIMIT_HEAVY_MAX=40
RATE_LIMIT_AUTH_MAX=30

# AI LLM Provider Configuration (Google Gemini / OpenAI)
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

